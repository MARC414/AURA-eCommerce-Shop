# Cloudflare Pages HTTP Headers
# Protect preview/development URL from search indexation (per decision D-012/D-014)
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Short-lived revalidation for unhashed stylesheets, scripts, and JSON indexes
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# Long-lived caching for immutable image and media assets
/assets/brand/*
  Cache-Control: public, max-age=31536000, immutable

/assets/botanicals/*
  Cache-Control: public, max-age=31536000, immutable

/assets/products/*
  Cache-Control: public, max-age=31536000, immutable
